*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.engine
*.safetensors
last_checkpoint

# Images (exclude all image files)
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.bmp
*.gif
*.webp
*.ico

# Temporary files & runtime locks
*.lock
.*.lock
*.tmp
