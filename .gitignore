# Byte-compiled / optimized / AST cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Datasets
wwtp_semantic_dataset/
wwtp_semantic_dataset_1m/
wwtp_semantic_dataset*.tar*
/data/remote_sensing/
/data/

# Model weights & checkpoints (exclude large training weights)
*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.engine
*.safetensors
last_checkpoint

# Images (exclude all image files)
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.bmp
*.gif
*.webp
*.ico

# Temporary files & runtime locks
*.lock
.*.lock
*.tmp

# Generated experiment artifacts and local environments
work_dirs/
# work_dirs may be replaced by a symlink to a larger volume. The trailing-slash
# pattern above only matches directories, so the bare name keeps that form out
# of git status as well.
work_dirs
analysis/
.venv*/
.cache/
